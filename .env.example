# Telegram credentials — FILL IN YOURSELF in `.env.local`, never commit it.
# Get your own pair at https://my.telegram.org (login with your phone number).
# NEVER paste these values in chat or commit them to the repo.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bot API token (fallback backend: inbox via getUpdates / sendMessage).
# The glasses web app reads it as VITE_TELEGRAM_BOT_TOKEN — set that exact
# name in `.env.local`. Without it the app runs on labelled MOCK data.
VITE_TELEGRAM_BOT_TOKEN=
# (Plain TELEGRAM_BOT_TOKEN is kept for server-side use; the web app ignores it.)
TELEGRAM_BOT_TOKEN=
